              "raw": "{{baseUrl}}/api/users/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "999"]
            },
            "description": "Attempts to retrieve a user with nonexistent ID 999."
          }
        },
        {
          "name": "5. Get User By ID - Invalid Format (400 Bad Request)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/invalid-id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "invalid-id"]
            },
            "description": "Attempts to retrieve a user with a non-numeric ID parameter."
          }
        }
      ]
    },
    {
      "name": "POST Requests",
      "item": [
        {
          "name": "6. Create User - Success (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bethelhem Tadesse\",\n  \"email\": \"bethelhem@example.com\",\n  \"age\": 22\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Creates a new user with valid name, email, and age."
          }
        },
        {
          "name": "7. Create User - Missing Name (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"noname@example.com\",\n  \"age\": 25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Fails validation because 'name' is missing."
          }
        },
        {
          "name": "8. Create User - Invalid Email Format (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"not-an-email\",\n  \"age\": 30\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Fails validation because 'email' does not match standard email pattern."
          }
        },
        {
          "name": "9. Create User - Negative Age (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"age\": -5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Fails validation because 'age' must be a positive integer."
          }
        },
        {
          "name": "10. Create User - Duplicate Email (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Abebe\",\n  \"email\": \"abebe@example.com\",\n  \"age\": 29\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Fails validation because 'abebe@example.com' is already registered."
          }
        }
      ]
    },

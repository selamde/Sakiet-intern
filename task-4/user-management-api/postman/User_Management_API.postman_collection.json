            "description": "Fails with 404 because user ID 999 does not exist."
          }
        },
        {
          "name": "13. Update User - Duplicate Email Conflict (400 Bad Request)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sara@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"]
            },
            "description": "Fails with 400 because 'sara@example.com' belongs to user ID 2."
          }
        }

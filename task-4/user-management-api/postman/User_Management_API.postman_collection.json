      ]
    },
    {
      "name": "GET Requests",
      "item": [
        {
          "name": "2. Get All Users (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Retrieves the full list of all registered users."
          }
        },
        {
          "name": "3. Get User By ID - Success (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"]
            },
            "description": "Retrieves user with ID 1 (Abebe Kebede)."
          }
        },
        {
          "name": "4. Get User By ID - Not Found (404 Not Found)",
          "request": {
            "method": "GET",
            "header": [],
